# Copy to .env and fill in. Never commit .env.

# --- Meta models ---
BASETEN_API_KEY=                # Muse Spark Open on Baseten (meta-models/muse-spark-open-1026)
META_MODEL_API_KEY=             # Meta Model API: SAM 3.1 (sam-3.1)
ALLOW_PAID_INFERENCE=true       # false = no SAM calls (cached results still replay)
CS_SAM_MAX_CALLS=400            # per run; cache hits are free
CS_SAM_CHECK_S=4.0              # clip seconds between SAM checks of one tracked person
CS_SAM_CONCEPTS=gun             # comma list, e.g. gun,knife

# --- Call ---
CS_CALL_MODE=                   # live = dial SignalWire; empty = on-screen AI-to-AI call (Muse plays dispatcher)

# --- Video ---
CS_MEDIA_ROOT=                  # folder with CAM01/CAM02/CAM03 *_339s.mp4
CS_VISION_SEVILLE=1
CS_VISION_DEVICE=mps            # mps (Apple Silicon) | cpu | cuda:0
CS_VISION_CONF=0.50
CS_VISION_COOLDOWN_S=600
CS_VISION_MAX_UPSERTS_MIN=1

# --- Voice / phone (optional) ---
ELEVENLABS_API_KEY=
CS_TTS_PROVIDER=                # elevenlabs for phone audio
CS_SIGNALWIRE_ENABLED=0
CS_KILL_SWITCH=0
CS_SIGNALWIRE_SMS_FALLBACK_CALL=0
SIGNALWIRE_SPACE=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_FROM_NUMBER=
SIGNALWIRE_TO_NUMBER=           # the ONE verified number calls may go to; never 911
CS_PUBLIC_BASE=
CS_DB_PATH=
